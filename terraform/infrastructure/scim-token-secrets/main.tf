terraform {
  backend "s3" {}
}

locals {
  secret_prefix = "onedata/snowflake"
  kms_prefix    = "onedata-snowflake"
}

# KMS key for SCIM token secrets
resource "aws_kms_key" "scim_tokens" {
  description             = "KMS key for Snowflake SCIM tokens"
  deletion_window_in_days = 30
  enable_key_rotation     = true

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid    = "AllowRootAccess"
        Effect = "Allow"
        Principal = {
          AWS = "arn:aws:iam::${data.aws_caller_identity.current.account_id}:root"
        }
        Action   = "kms:*"
        Resource = "*"
      },
      {
        Sid    = "AllowRotatorRole"
        Effect = "Allow"
        Principal = {
          AWS = var.rotator_role_arn
        }
        Action = [
          "kms:Encrypt",
          "kms:Decrypt",
          "kms:GenerateDataKey*",
          "kms:DescribeKey"
        ]
        Resource = "*"
      },
      {
        Sid    = "AllowOktaDecrypt"
        Effect = "Allow"
        Principal = {
          AWS = var.okta_role_arn
        }
        Action = [
          "kms:Decrypt",
          "kms:DescribeKey"
        ]
        Resource = "*"
      }
    ]
  })

  tags = {
    Name = "${local.kms_prefix}-${var.env_type}-scim-tokens"
  }
}

resource "aws_kms_alias" "scim_tokens" {
  name          = "alias/${local.kms_prefix}-${var.env_type}-scim-tokens"
  target_key_id = aws_kms_key.scim_tokens.key_id
}

data "aws_caller_identity" "current" {}

# Per-account SCIM token secrets (one per account, not per environment)
# checkov:skip=CKV2_AWS_57:Rotation handled by external script - tokens generated by Snowflake, not AWS
resource "aws_secretsmanager_secret" "scim_token" {
  for_each = toset(var.snowflake_accounts)

  name        = "${local.secret_prefix}/${each.value}/${var.env_type}/scim-token"
  description = "SCIM token for Snowflake ${each.value} ${var.env_type} account"
  kms_key_id  = aws_kms_key.scim_tokens.arn

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid    = "AllowRotatorWrite"
        Effect = "Allow"
        Principal = {
          AWS = var.rotator_role_arn
        }
        Action = [
          "secretsmanager:GetSecretValue",
          "secretsmanager:PutSecretValue",
          "secretsmanager:UpdateSecretVersionStage",
          "secretsmanager:DescribeSecret"
        ]
        Resource = "*"
      },
      {
        Sid    = "AllowOktaRead"
        Effect = "Allow"
        Principal = {
          AWS = var.okta_role_arn
        }
        Action = [
          "secretsmanager:GetSecretValue",
          "secretsmanager:DescribeSecret"
        ]
        Resource = "*"
      }
    ]
  })

  tags = {
    Name    = "${local.secret_prefix}/${each.value}/scim-token"
    Account = each.value
  }
}

# Initial empty secret value
resource "aws_secretsmanager_secret_version" "scim_token_initial" {
  for_each = toset(var.snowflake_accounts)

  secret_id = aws_secretsmanager_secret.scim_token[each.value].id
  secret_string = jsonencode({
    token           = ""
    last_updated    = null
    expires_at      = null
    okta_configured = false
  })

  lifecycle {
    ignore_changes = [secret_string]
  }
}
