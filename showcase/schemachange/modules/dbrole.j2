{% import 'modules/support.j2' as support with context -%}

{#-
    This file is part of the Schemachange project.
    It provides macros for managing database roles in Snowflake.

    Macros included:
        - name: Generates the name of a database role based on the provided parameters.
        - create: Creates a new database role with optional comment and tags.
        - drop: Drops an existing database role.
        - comment: Sets or unsets the comment for a database role.
        - tag: Adds or removes tags from a database role.
        - grant_to_role: Grants usage of a database role to a role.
        - grant_to_user: Grants usage of a database role to a user.
        - revoke_from_role: Revokes usage of a database role from a role.
        - revoke_from_user: Revokes usage of a database role from a user.

    Privileges required?:
        SYSADMIN
        SECURITYADMIN
-#}

{#-
    Generate the name of a database role based on the provided parameters.
    This macro constructs the role name using the provided rolename, function,
    and optional dbname. The function can be "A" for admin roles or "S" for
    data share roles.

    Preconditions:
        rolename - The role name must be provided and cannot be empty
        function - must be one of "A" (admin) or "S" (data share).

    Returns:
        A string representing the role name in the format: ROLENAME_TYPE

    Raises:
        An error if rolename is not provided or is empty.
        An error if function is not one of 'A' or 'S'.

    Example Usage:
        {{ dbrole.name('DATABASE', 'A') }}
        {{ dbrole.name('ENGINEER', 'S') }}
        {{ dbrole.name('DATABASE', 'A', 'OTHERDB') }}

    Example Returns:
        DATABASE_DBROLE_A
        ENGINEER_DATASHARE_DBROLE
        OTHERDB.DATABASE_DBROLE_A
-#}
{% macro name(rolename, function, dbname=none) -%}
    {%- if not rolename or rolename | trim == "" -%}
        {{ support.raise("rolename must be provided to dbrole.name macro") }}
    {%- endif -%}
    {%- if not function or function | trim | upper not in ["A", "S"] -%}
        {{ support.raise("function must be provided as one of 'A' or 'S' to dbrole.name macro") }}
    {%- else -%}
        {%- set function = function | trim | upper -%}
    {%- endif -%}
    {%- if function == "A" -%}
        {% set type = "_DBROLE_A" %}
    {%- elif function == "S" -%}
        {% set type = "_DATASHARE_DBROLE" %}
    {%- endif -%}
    {%- if dbname and dbname | trim != "" -%}
        {%- set dbname = (dbname | trim | upper) + "." -%}
    {%- else -%}
        {%- set dbname = "" -%}
    {%- endif -%}
    {{ dbname }}{{ rolename | trim | upper }}{{ type | trim | upper }}
{%- endmacro %}

{#-
    Create a new database role in Snowflake.
    This macro creates a database role with the specified rolename, function,
    optional dbname, comment, and tags.

    Preconditions:
        rolename - The role name must be provided and cannot be empty.
        function - must be one of "A" (admin) or "S" (data share).
        dbname - Optional, if provided, must be a valid database name.
        comment - Optional, if provided, must be a string.
        tags - Optional, if provided, must be a dictionary.

    Returns:
        A SQL statement to create the database role.

    Raises:
        An error if rolename is not provided or is empty.
        An error if function is not one of 'A' or 'S'.
        An error if tags is provided but not as a dictionary.

    Example usage:
        {{ dbrole.create('DATABASE', 'A') }}
        {{ dbrole.create('ENGINEER', 'S', 'OTHERDB', 'This is an engineer role') }}
-#}
{% macro create(rolename, function, dbname=none, comment=none, tags={}) -%}
    {%- set function = function | upper -%}
    {%- if function not in ["A", "S"] -%}
        {{ support.raise('function must be one of ["A", "S"] for the dbrole.create macro') }}
    {%- endif -%}
    {%- if tags and not tags is mapping -%}
        {{ support.raise("tags must be provided as a dictionary to the dbrole.create macro") }}
    {%- endif -%}
    {%- set role = name(rolename, function, dbname) -%}
{{ support.use_role('SYSADMIN', 'SAVE_ROLE_DBROLE_CREATE') }}
CREATE DATABASE ROLE {{ role }}
    {%- if comment %}
    COMMENT = {{ support.snowflake_safe_string(comment) }}
    {%- endif -%}
    {%- if tags -%}
        {%- set taglist -%}
            {{ support.tag_list(tags) }}
        {%- endset -%}
        {%- if taglist | trim %}
    TAG (
        {{ taglist }}
        )
        {%- endif -%}
    {%- endif -%}
    ;
{{ support.restore_role('SAVE_ROLE_DBROLE_CREATE') }}
{%- endmacro %}

{#-
    Drop an existing database role in Snowflake.
    This macro drops a database role with the specified rolename and function.

    Preconditions:
        rolename - The role name must be provided and cannot be empty.
        function - must be one of "A" (admin) or "S" (data share).
        dbname - Optional, if provided, must be a valid database name.

    Returns:
        A SQL statement to drop the database role.

    Raises:
        An error if rolename is not provided or is empty.
        An error if function is not one of 'A' or 'S'.

    Example usage:
        {{ dbrole.drop('DATABASE', 'A') }}
        {{ dbrole.drop('ENGINEER', 'S', 'OTHERDB') }}

    Example Returns:
        DROP DATABASE ROLE IF EXISTS DATABASE_DBROLE_A;
        DROP DATABASE ROLE IF EXISTS OTHERDB.ENGINEER_DATASHARE_DBROLE;
-#}
{% macro drop(rolename, function, dbname=none) -%}
    {%- set role = name(rolename, function, dbname) -%}
{{ support.use_role('SYSADMIN', 'SAVE_ROLE_DBROLE_DROP') }}
DROP DATABASE ROLE IF EXISTS {{ role }};
{{ support.restore_role('SAVE_ROLE_DBROLE_DROP') }}
{%- endmacro %}

{#-
    Set or unset the comment for a database role in Snowflake.
    This macro sets or unsets the comment for a database role with the specified
    rolename, function, and optional dbname.

    Preconditions:
        rolename - The role name must be provided and cannot be empty.
        function - must be one of "A" (admin) or "S" (data share).
        dbname - Optional, if provided, must be a valid database name.
        comment - Optional, if provided, must be a string.

    Returns:
        A SQL statement to set or unset the comment for the database role.

    Raises:
        An error if rolename is not provided or is empty.
        An error if function is not one of 'A' or 'S'.

    Example usage:
        {{ dbrole.comment('DATABASE', 'A', comment='This is a test role') }}
        {{ dbrole.comment('ENGINEER', 'S', 'OTHERDB') }}

    Example Returns:
        ALTER DATABASE ROLE DATABASE_DBROLE_A SET COMMENT = $$This is a test role$$;
        ALTER DATABASE ROLE OTHERDB.ENGINEER_DATASHARE_DBROLE UNSET COMMENT;
-#}
{% macro comment(rolename, function, dbname=false, comment=none) -%}
    {%- set role = name(rolename, function, dbname) -%}
{{ support.use_role('SYSADMIN', 'SAVE_ROLE_DBROLE_COMMENT') }}
    {%- if comment %}
ALTER DATABASE ROLE {{ role }}
    SET COMMENT = {{ support.snowflake_safe_string(comment) }};
    {%- else %}
ALTER DATABASE ROLE {{ role }}
    UNSET COMMENT;
    {%- endif %}
{{ support.restore_role('SAVE_ROLE_DBROLE_COMMENT') }}
{%- endmacro %}

{#-
    Add or remove tags from a database role in Snowflake.
    This macro adds or removes tags from a database role with the specified
    rolename, function, optional dbname, and tags.

    Preconditions:
        rolename - The role name must be provided and cannot be empty.
        function - must be one of "A" (admin) or "S" (data share).
        dbname - Optional, if provided, must be a valid database name.
        tags - Optional, if provided, must be a dictionary.

    Returns:
        A SQL statement to add or remove tags from the database role.

    Raises:
        An error if rolename is not provided or is empty.
        An error if function is not one of 'A' or 'S'.
        An error if tags is provided but not as a dictionary.

    Example usage:
        {{ dbrole.tag('DATABASE', 'A', tags={'TEST_TAG':'Test Value'}) }}
        {{ dbrole.tag('ENGINEER', 'S', 'OTHERDB') }}

    Example Returns:
        ALTER DATABASE ROLE DATABASE_DBROLE_A SET TAG TEST_TAG = $$Test Value$$;
        ALTER DATABASE ROLE OTHERDB.ENGINEER_DATASHARE_DBROLE UNSET TAG;
-#}
{% macro tag(rolename, function, dbname=false, tags={}) -%}
    {%- if tags and not tags is mapping -%}
        {{ support.raise("tags must be provided as a dictionary to the role.tag macro") }}
    {%- endif -%}
    {%- set role = name(rolename, function, dbname) -%}
    {%- set addtaglist -%}
        {{ support.tag_list(tags) }}
    {%- endset -%}
    {%- set deltaglist -%}
        {{ support.tag_list(tags, false) }}
    {%- endset -%}
    {%- if addtaglist | trim or deltaglist | trim -%}
{{ support.use_role('SYSADMIN', 'SAVE_ROLE_DBROLE_TAG') }}
        {%- if addtaglist | trim %}
ALTER DATABASE ROLE {{ role }}
    SET TAG
        {{ addtaglist }};
        {%- endif -%}
        {%- if deltaglist | trim %}
ALTER DATABASE ROLE {{ role }}
    UNSET TAG {{ deltaglist }};
        {%- endif %}
{{ support.restore_role('SAVE_ROLE_DBROLE_TAG') }}
    {%- endif -%}
{%- endmacro %}

