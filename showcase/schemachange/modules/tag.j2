{% import 'modules/support.j2' as support with context -%}

{#-
    This module provides macros for creating, dropping, commenting on,
    and managing allowed values for tags in Snowflake.

    The tag name is constructed based on the environment, database, schema,
    and purpose provided. The environment must be one of DEV, TST, PST, or PRD.
    The database and schema must also be provided.

    Macros:
        - name: Constructs the tag name.
        - create: Creates a tag with optional allowed values and comment.
        - drop: Drops a tag if it exists.
        - comment: Sets or unsets a comment on a tag.
        - add_allowed_values: Adds allowed values to a tag.
        - drop_allowed_values: Drops allowed values from a tag.
        - grant_usage: Grants usage on a tag to a role.
        - revoke_usage: Revokes usage on a tag from a role.
-#}

{#-
    Returns the name of the tag based on the environment, database, schema, and purpose.
    This macro is used to ensure consistent naming conventions across different environments (DEV, TST, PST, PRD).

    Preconditions:
        global_var in_sf_env should be set to one of DEV, TST, PST, PRD
        db - The database name must be provided and cannot be empty
        schema - The schema name must be provided and cannot be empty
        purpose - The purpose of the tag must be provided and cannot be empty

    Returns:
        A string formatted as <in_sf_env>_<db>.<schema>.<purpose>, e.g., DEV_PROJECT.PART1.PI_NAME

    Raises:
        An error if in_sf_env is not set or is not one of DEV, TST, PST, PRD
        An error if db, schema, or purpose is not provided or is empty

    Example Usage:
        {{ schema.name('PROJECT', 'PART1', 'PI_NAME') }}

    Example Returns:
        DEV_PROJECT.PART1.PI_NAME
-#}
{% macro name(db, schema, purpose) -%}
    {%- if not in_sf_env or in_sf_env | trim | upper not in ['DEV', 'TST', 'PST', 'PRD']  -%}
        {{ support.raise("in_sf_env must be one of DEV, TST, PST, PRD") }}
    {%- endif -%}
    {%- if not db or db | trim == "" -%}
        {{ support.raise("db must be provided to tag.name macro") }}
    {%- endif -%}
    {%- if not schema or schema | trim == "" -%}
        {{ support.raise("schema must be provided to tag.name macro") }}
    {%- endif -%}
    {%- if not purpose or purpose | trim == "" -%}
        {{ support.raise("purpose must be provided to tag.name macro") }}
    {%- endif -%}
    {{ in_sf_env | trim | upper }}_{{ db | trim | upper }}.{{ schema | trim | upper }}.{{ purpose | trim | upper }}
{%- endmacro %}

{#-
    Creates a tag in Snowflake with the specified database, schema, and purpose.
    Optionally, allowed values and a comment can be provided.

    Preconditions:
        db - The database name must be provided and cannot be empty
        schema - The schema name must be provided and cannot be empty
        purpose - The purpose of the tag must be provided and cannot be empty
        comment - A comment for the tag (optional)
        values - A list of allowed values for the tag (optional)

    Returns:
        A SQL statement to create a tag with the specified parameters.

    Raises:
        An error if db, schema, or purpose is not provided or is empty
        An error if values is not a list when provided

    Example Usage:
        {{ tag.create('PROJECT', 'PART1', 'PI_NAME', 'This is a tag comment', ['value1', 'value2']) }}

    Example Returns:
        Creates a tag named DEV_PROJECT.PART1.PI_NAME with allowed values and comment
-#}
{% macro create(db, schema, purpose, comment=none, values=[]) -%}
    {%- if not db or db | trim == "" -%}
        {{ support.raise("db must be provided to tag.create macro") }}
    {%- endif -%}
    {%- if not schema or schema | trim == "" -%}
        {{ support.raise("schema must be provided to tag.create macro") }}
    {%- endif -%}
    {%- if not purpose or purpose | trim == "" -%}
        {{ support.raise("purpose must be provided to tag.create macro") }}
    {%- endif -%}
    {% if values and not values is sequence -%}
        {{ support.raise("tags must be provided as a list to the tag.create macro") }}
    {%- endif -%}

{{ support.use_role('SYSADMIN', 'SAVE_ROLE_TAG_CREATE') }}
CREATE TAG {{ name(db, schema, purpose) }}
    {%- if values and (values is sequence or values is string) %}
    ALLOWED_VALUES = {{ support.upper_list_strings(values) }}
    {%- endif %}
    {%- if comment %}
    COMMENT = {{ support.snowflake_safe_string(comment) }}
    {%- endif -%}
    ;
{{ support.restore_role('SAVE_ROLE_TAG_CREATE') }}
{%- endmacro %}

{#-
    Drops a tag in Snowflake if it exists.

    Preconditions:
        db - The database name must be provided and cannot be empty
        schema - The schema name must be provided and cannot be empty
        purpose - The purpose of the tag must be provided and cannot be empty

    Returns:
        A SQL statement to drop the tag if it exists.

    Raises:
        An error if db, schema, or purpose is not provided or is empty

    Example Usage:
        {{ tag.drop('PROJECT', 'PART1', 'PI_NAME') }}

    Example Returns:
        DROP TAG IF EXISTS DEV_PROJECT.PART1.PI_NAME;
-#}
{% macro drop(db, schema, purpose) -%}
{{ support.use_role('SYSADMIN', 'SAVE_ROLE_TAG_DROP') }}
DROP TAG IF EXISTS {{ name(db, schema, purpose) }};
{{ support.restore_role('SAVE_ROLE_TAG_DROP') }}
{%- endmacro %}

{#-
    Sets or unsets a comment on a tag in Snowflake.

    Preconditions:
        db - The database name must be provided and cannot be empty
        schema - The schema name must be provided and cannot be empty
        purpose - The purpose of the tag must be provided and cannot be empty
        comment - A comment for the tag (optional)

    Returns:
        A SQL statement to set or unset the comment on the tag.

    Raises:
        An error if db, schema, or purpose is not provided or is empty

    Example Usage:
        {{ tag.comment('PROJECT', 'PART1', 'PI_NAME', 'This is a tag comment') }}
        {{ tag.comment('PROJECT', 'PART1', 'PI_NAME') }}

    Example Returns:
        ALTER TAG DEV_PROJECT.PART1.PI_NAME SET COMMENT 'This is a tag comment';
        ALTER TAG DEV_PROJECT.PART1.PI_NAME UNSET COMMENT;
-#}
{% macro comment(db, schema, purpose, comment=none) -%}
{{ support.use_role('SYSADMIN', 'SAVE_ROLE_STAGE_COMMENT') }}
    {%- if comment %}
ALTER TAG {{ name(db, schema, purpose) }}
    SET COMMENT {{ support.snowflake_safe_string(comment) }};
    {%- else %}
ALTER TAG {{ name(db, schema, purpose) }}
    UNSET COMMENT;
    {%- endif %}
{{ support.restore_role('SAVE_ROLE_STAGE_COMMENT') }}
{%- endmacro %}

{#-
    Adds allowed values to a tag in Snowflake.

    Preconditions:
        db - The database name must be provided and cannot be empty
        schema - The schema name must be provided and cannot be empty
        purpose - The purpose of the tag must be provided and cannot be empty
        values - A list of allowed values for the tag and cannot be empty

    Returns:
        A SQL statement to add allowed values to the tag.

    Raises:
        An error if db, schema, or purpose is not provided or is empty
        An error if values is not a list when provided

    Example Usage:
        {{ tag.add_allowed_values('PROJECT', 'PART1', 'PI_NAME', ['value1', 'value2']) }}

    Example Returns:
        ALTER TAG DEV_PROJECT.PART1.PI_NAME ADD ALLOWED_VALUES 'VALUE1', 'VALUE2';
-#}
{% macro add_allowed_values(db, schema, purpose, values=[]) -%}
    {%- if values is sequence or values is string -%}
        {%- set valuelist -%}
            {{ support.upper_list_strings(values) }}
        {%- endset -%}
    {%- else -%}
        {{ support.raise("values must be provided as a list to the stage.add_allowed_values macro") }}
    {%- endif -%}
    {%- if valuelist -%}
{{ support.use_role('SYSADMIN', 'SAVE_ROLE_TAG_VALUES') }}
ALTER TAG {{ name(db, schema, purpose) }}
    ADD ALLOWED_VALUES {{ valuelist }};
{{ support.restore_role('SAVE_ROLE_TAG_VALUES') }}
    {%- endif -%}
{%- endmacro %}

{#-
    Drops allowed values from a tag in Snowflake.

    Preconditions:
        db - The database name must be provided and cannot be empty
        schema - The schema name must be provided and cannot be empty
        purpose - The purpose of the tag must be provided and cannot be empty
        values - A list of allowed values to drop

    Returns:
        A SQL statement to drop allowed values from the tag.

    Raises:
        An error if db, schema, or purpose is not provided or is empty
        An error if values is not a list when provided

    Example Usage:
        {{ tag.drop_allowed_values('PROJECT', 'PART1', 'PI_NAME', ['value1', 'value2']) }}
        {{ tag.drop_allowed_values('PROJECT', 'PART1', 'PI_NAME') }}

    Example Returns:
        ALTER TAG DEV_PROJECT.PART1.PI_NAME DROP ALLOWED_VALUES 'VALUE1', 'VALUE2';
        ALTER TAG DEV_PROJECT.PART1.PI_NAME UNSET ALLOWED_VALUES;
-#}
{% macro drop_allowed_values(db, schema, purpose, values=[]) -%}
    {%- set tagname = name(db, schema, purpose) -%}
    {%- if values is sequence or values is string -%}
        {%- set valuelist -%}
            {{ support.upper_list_strings(values) }}
        {%- endset -%}
    {%- else -%}
        {{ support.raise("values must be provided as a list to the stage.drop_allowed_values macro") }}
    {%- endif -%}
{{ support.use_role('SYSADMIN', 'SAVE_ROLE_TAG_VALUES') }}
    {%- if valuelist %}
ALTER TAG {{ tagname }}
    DROP ALLOWED_VALUES {{ valuelist }};
    {%- else %}
ALTER TAG {{ tagname }}
    UNSET ALLOWED_VALUES;
    {%- endif %}
{{ support.restore_role('SAVE_ROLE_TAG_VALUES') }}
{%- endmacro %}

