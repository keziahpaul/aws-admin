{% import 'modules/support.j2' as support with context -%}
{#-
    This file is part of the Schemachange project.
    It provides macros for managing databases in Snowflake.

    Macros included:
        - name: Returns the name of the database based on the environment and db name.
        - from_share: Returns the name of the share based on the source environment and database name.
        - create: Creates a new database with the specified name, comment, and tag.
        - drop: Drops the specified database if it exists.
        - use: Sets the current database to the specified database.
        - comment: Sets or unsets a comment on an existing database.
        - tag: Sets or unsets a tag on the specified database.
        - grant_usage: Grants usage on the specified database to a role.
        - revoke_usage: Revokes usage on the specified database from a role.

    Privileges required?:
        CREATE DATABASE
-#}

{#-
    Return the name of the database based on the environment and db name.
    This macro is used to create a consistent naming convention for databases across different environments.

    Preconditions:
        global var in_sf_env should be set to one of DEV, TST, PST, PRD
        db - the primary database name must be provided and not empty

    Returns:
        A string in the format of <in_sf_env>_<db>, e.g., DEV_PROJECT

    Raises:
        An error if in_sf_env is not set or not one of DEV, TST, PST, PRD
        An error if db is not provided or is empty

    Example Usage:
        {{ database.name('PROJECT') }}

    Example Returns:
        DEV_PROJECT
-#}
{% macro name(db) -%}
    {%- if not db or db | trim == "" -%}
        {{ support.raise("db must be provided to database.name macro") }}
    {%- endif -%}
    {%- if not in_sf_env or in_sf_env | trim | upper not in ['DEV', 'TST', 'PST', 'PRD']  -%}
        {{ support.raise("in_sf_env must be one of DEV, TST, PST, PRD") }}
    {%- endif -%}
    {{ in_sf_env | trim | upper }}_{{ db | trim | upper }}
{%- endmacro %}

{#-
    Return the name of the share based on the source environment and database name.
    This macro is used to create a consistent naming convention for shares across different environments.

    Preconditions:
        global var in_sf_env should be one of DEV, TST, PST, PRD
        src_env - the source environment from which the share is being created, must be one of DEV, TST, PST, PRD
        db - the primary database name must be provided and not empty

    Returns:
        A string in the format of <src_env>_<db>_SHARED, e.g., TST_PROJECT_SHARED

    Raises:
        An error if src_env is not provided or is not one of DEV, TST, PST, PRD
        An error if db is not provided or is empty
        An error if src_env is the same as in_sf_env

    Example Usage:
        {{ database.from_share('TST', 'PROJECT') }}

    Example Returns:
        TST_PROJECT_SHARED
-#}
{% macro from_share(src_env, db) -%}
    {%- if src_env | trim | upper not in ['DEV', 'TST', 'PST', 'PRD'] or src_env | trim | upper == in_sf_env | trim | upper -%}
        {{ support.raise("src_env must be one of DEV, TST, PST, PRD and not " + (in_sf_env | trim | upper)) }}
    {%- endif -%}
    {%- if not db or db | trim == "" -%}
        {{ support.raise("db must be provided to database.from_share macro") }}
    {%- endif -%}
    {{ src_env | trim | upper }}_{{ db | trim | upper }}_SHARED
{%- endmacro %}

{#-
    Create a new database with the specified name, comment, and tags.
    This macro is used to create a new database in Snowflake with optional metadata.

    Preconditions:
        db - the primary database name must be provided and not empty
        comment - an optional comment for the database
        tags - an optional dictionary of {tag: value} to set on the database

    Returns:
        A CREATE DATABASE command for the specified database.

    Raises:
        An error if db is not provided or is empty
        An error if tags is provided and is not a dictionary

    Example Usage:
        {{ database.create('PROJECT') }}
        {{ database.create('PROJECT', 'This is a test database') }}
        {{ database.create('PROJECT', tags={'environment': 'production'}) }}
        {{ database.create('PROJECT', 'This is a test database', tags={'environment': 'production'}) }}

    Example Returns:
        CREATE DATABASE DEV_PROJECT;
        CREATE DATABASE DEV_PROJECT COMMENT = $$This is a test database$$;
        CREATE DATABASE DEV_PROJECT TAG (ENVIRONMENT = $$production$$);
        CREATE DATABASE DEV_PROJECT COMMENT = $$This is a test database$$ TAG (ENVIRONMENT = $$production$$);
-#}
{% macro create(db, comment=none, tags={}) -%}
    {% if tags and not tags is mapping -%}
        {{ support.raise("tags must be provided as a dictionary to the database.create macro") }}
    {% endif -%}
    {%- set dbname = name(db) -%}
{{ support.use_role('SYSADMIN', 'SAVE_ROLE_DB_CREATE') }}
CREATE DATABASE {{ dbname }}
    {%- if comment %}
    COMMENT = {{ support.snowflake_safe_string(comment) }}
    {%- endif -%}
    {%- if tags -%}
        {%- set taglist -%}
            {{ support.tag_list(tags) }}
        {%- endset -%}
        {%- if taglist | trim %}
    TAG (
        {{ taglist }}
        )
        {%- endif -%}
    {%- endif -%}
    ;
{{ support.restore_role('SAVE_ROLE_DB_CREATE') }}
{%- endmacro %}

{#-
    Create a new database from an existing share.
    This macro is used to create a new database in Snowflake from a shared database.

    Preconditions:
        db - the primary database name must be provided and not empty
        share - the name of the share from which to create the database, must be provided and not empty

    Returns:
        A CREATE DATABASE command for the specified database from the share.

    Raises:
        An error if db or share is not provided or is empty

    Example Usage:
        {{ database.create_from_share('PROJECT', 'PRD_SHARED_PROJECT') }}

    Example Returns:
        CREATE DATABASE DEV_PROJECT FROM SHARE PRD_SHARED_PROJECT;
-#}
{% macro create_from_share(db, share) -%}
    {%- if not db or db | trim == "" -%}
        {{ support.raise("db must be provided to database.create_from_share macro") }}
    {%- endif -%}
    {%- if not share or share | trim == "" -%}
        {{ support.raise("share must be provided to database.create_from_share macro") }}
    {%- else -%}
        {% set share = share | trim | upper %}
    {%- endif -%}
    {%- set dbname = name(db) -%}
{{ support.use_role('SYSADMIN', 'SAVE_ROLE_DB_CREATE') }}
CREATE DATABASE {{ dbname }} FROM SHARE {{ share }};
{{ support.restore_role('SAVE_ROLE_DB_CREATE') }}
{%- endmacro %}

{#-
    Drop the specified database if it exists.
    This macro is used to remove a database from Snowflake.

    Preconditions:
        db - the database to drop, must be provided and not empty

    Returns:
        A DROP DATABASE command for the specified database.

    Raises:
        An error if db is not provided or is empty

    Example Usage:
        {{ database.drop('PROJECT') }}

    Example Returns:
        DROP DATABASE IF EXISTS DEV_PROJECT;
-#}
{% macro drop(db) -%}
    {%- set dbname = name(db) -%}
{{ support.use_role('SYSADMIN', 'SAVE_ROLE_DB_DROP') }}
DROP DATABASE IF EXISTS {{ dbname }};
{{ support.restore_role('SAVE_ROLE_DB_DROP') }}
{%- endmacro %}

{#-
    Use the specified database in Snowflake.
    This macro is used to set the current database context for subsequent operations.

    Preconditions:
        db - the database to use, must be provided and not empty

    Returns:
        A USE DATABASE command for the specified database.

    Raises:
        An error if db is not provided or is empty

    Example Usage:
        {{ database.use('PROJECT') }}

    Example Returns:
        USE DATABASE DEV_PROJECT;
-#}
{% macro use(db) -%}
    {%- set dbname = name(db) -%}
USE DATABASE {{ dbname }};
{%- endmacro %}

{#-
    Set or unset a comment on an existing database.
    This macro is used to add or remove comments from a database for documentation purposes.

    Preconditions:
        db - the database on which to set the comment, must be provided and not empty
        comment - the comment to set, can be empty to unset the comment

    Returns:
        An ALTER DATABASE command to set or unset the comment.

    Raises:
        An error if db is not provided or is empty

    Example Usage:
        {{ database.comment('PROJECT', 'This is a test database') }}
        {{ database.comment('PROJECT') }}

    Example Returns:
        ALTER DATABASE DEV_PROJECT SET COMMENT = $$This is a test database$$;
        ALTER DATABASE DEV_PROJECT UNSET COMMENT;
-#}
{% macro comment(db, comment=none) -%}
    {%- set dbname = name(db) -%}
{{ support.use_role('SYSADMIN', 'SAVE_ROLE_DB_COMMENT') }}
    {%- if comment %}
ALTER DATABASE {{ dbname }}
    SET COMMENT = {{ support.snowflake_safe_string(comment) }};
    {%- else %}
ALTER DATABASE {{ dbname }}
    UNSET COMMENT;
    {%- endif %}
{{ support.restore_role('SAVE_ROLE_DB_COMMENT') }}
{%- endmacro %}

{#-
    Set or unset a tag on the specified database.
    This macro is used to manage tags for databases, which can be useful for categorization or metadata purposes.

    Preconditions:
        db - the database on which to set the tag, must be provided and not empty
        tags - a dictionary of {tag: value} to set/unset on the database

    Returns:
        An ALTER DATABASE command to set or unset the tag.

    Raises:
        An error if db or tag is not provided or is empty
        An error if tags is not a dictionary

    Example Usage:
        {{ database.tag('PROJECT', {'environment': 'production'}) }}
        {{ database.tag('PROJECT', {'environment': none}) }}

    Example Returns:
        ALTER DATABASE DEV_PROJECT SET TAG ENVIRONMENT = $$production$$;
        ALTER DATABASE DEV_PROJECT UNSET TAG ENVIRONMENT;
-#}
{% macro tag(db, tags) -%}
    {%- if tags and not tags is mapping -%}
        {{ support.raise("tags must be provided as a dictionary to the database.tag macro") }}
    {%- endif -%}
    {%- set dbname = name(db) -%}
    {%- set addtaglist -%}
        {{ support.tag_list(tags) }}
    {%- endset -%}
    {%- set deltaglist -%}
        {{ support.tag_list(tags, false) }}
    {%- endset -%}
    {%- if addtaglist | trim or deltaglist | trim -%}
{{ support.use_role('SYSADMIN', 'SAVE_ROLE_DB_TAG') }}
        {%- if addtaglist | trim %}
ALTER DATABASE {{ dbname }}
    SET TAG
        {{ addtaglist }};
        {%- endif -%}
        {%- if deltaglist | trim %}
ALTER DATABASE {{ dbname }}
    UNSET TAG {{ deltaglist }};
        {%- endif %}
{{ support.restore_role('SAVE_ROLE_DB_TAG') }}
    {%- endif -%}
{%- endmacro %}

{#-
    Grant usage on the specified database to a role.
    This macro is used to allow a role to access the database.

    Preconditions:
        db - the database to which usage is being granted, must be provided and not empty
        role - the role to which usage is being granted, must be provided and not empty
        isdbrole - boolean indicating if the role is a database role (optional, defaults to false)

    Returns:
        A GRANT USAGE command for the specified database and role.

    Raises:
        An error if db or role is not provided or is empty

    Example Usage:
        {{ database.grant_usage('PROJECT', 'ANALYST_ROLE') }}
        {{ database.grant_usage('PROJECT', 'DB.ANALYST_ROLE', true) }}

    Example Returns:
        GRANT USAGE ON DATABASE DEV_PROJECT TO ROLE ANALYST_ROLE;
        GRANT USAGE ON DATABASE DEV_PROJECT TO DATABASE ROLE DB.ANALYST_ROLE;
-#}
{% macro grant_usage(db, role, isdbrole=false) -%}
    {%- set dbname = name(db) -%}
    {%- if not role or role | trim == "" -%}
        {{ support.raise("role must be provided to database.grant_usage macro") }}
    {%- else -%}
        {%- set role = "ROLE " + role | trim | upper -%}
    {%- endif -%}
    {%- if isdbrole -%}
        {%- set role = "DATABASE " + role -%}
    {%- endif -%}
{{ support.use_role('SECURITYADMIN', 'SAVE_ROLE_GRANT') }}
GRANT USAGE ON DATABASE {{ dbname }} TO {{ role }};
{{ support.restore_role('SAVE_ROLE_GRANT') }}
{%- endmacro %}

{#-
    Revoke usage on the specified database from a role.
    This macro is used to remove access to the database from a role.

    Preconditions:
        db - the database from which usage is being revoked, must be provided and not empty
        role - the role from which usage is being revoked, must be provided and not empty
        isdbrole - boolean indicating if the role is a database role (optional, defaults to false)

    Returns:
        A REVOKE USAGE command for the specified database and role.

    Raises:
        An error if db or role is not provided or is empty

    Example Usage:
        {{ database.revoke_usage('PROJECT', 'ANALYST_ROLE') }}
        {{ database.revoke_usage('PROJECT', 'DB.ANALYST_ROLE', true) }}

    Example Returns:
        REVOKE USAGE ON DATABASE DEV_PROJECT FROM ROLE ANALYST_ROLE;
        REVOKE USAGE ON DATABASE DEV_PROJECT FROM DATABASE ROLE DB.ANALYST_ROLE;
-#}
{% macro revoke_usage(db, role, isdbrole=false) -%}
    {%- set dbname = name(db) -%}
    {%- if not role or role | trim == "" -%}
        {{ support.raise("role must be provided to database.revoke_usage macro") }}
    {%- else -%}
        {%- set role = "ROLE " + role | trim | upper -%}
    {%- endif -%}
    {%- if isdbrole -%}
        {%- set role = "DATABASE " + role -%}
    {%- endif -%}
{{ support.use_role('SECURITYADMIN', 'SAVE_ROLE_REVOKE') }}
REVOKE USAGE ON DATABASE {{ dbname }} FROM {{ role }};
{{ support.restore_role('SAVE_ROLE_REVOKE') }}
{%- endmacro %}
