{#-
    This file is part of the Schemachange project.
    It provides utility macros for Snowflake SQL operations.

    Macros included:
        - snowflake_safe_string: Converts a string to a safe format for Snowflake.
        - upper_list_strings: Converts a list of strings to a comma-separated, uppercased strings for Snowflake.
        - tag_list: Converts a dictionary to a Snowflake SET TAG list or UNSET TAG list.
        - use_role: Sets a new role and saves the current role for later restoration.
        - restore_role: Restores the previously saved role.
-#}

{#-
    Take user input and return a safe string for Snowflake.
    This macro replaces double dollar signs with dollar period to avoid issues
    with Snowflake's dollar-quoted string literals.

    Example Usage:
        {{ support.snowflake_safe_string("This is a $test$ string") }}
        {{ support.snowflake_safe_string("This is a $$test$$$ string") }}

    Example Returns:
        $$This is a $test$ string$$
        $$This is a $.test$.$ string$$
-#}
{% macro snowflake_safe_string(text) -%}
    $${{ text | replace("$$", "$.") }}$$
{%- endmacro %}

{#-
    Take a list of strings or a single string and return a comma-separated
    list of uppercased strings, safely formatted for Snowflake.

    Example Usage:
        {{ support.upper_list_strings(['hello', 'world', '$$$$']) }}
        {{ support.upper_list_strings('hello') }}
        {{ support.upper_list_strings(none) }}

    Example Returns:
        $$HELLO$$, $$WORLD$$, $$$.$.$$
        $$HELLO$$
        NULL

    If the input is not a sequence or mapping, it will be converted to uppercase.
    If the input is None, it returns NULL.
-#}
{% macro upper_list_strings(original_list) -%}
    {%- if original_list is sequence and original_list is not mapping and original_list is not string -%}
        {%- for elm in (original_list | map('upper')) -%}
            {%- if not loop.first %}, {% endif -%}
            {{ snowflake_safe_string(elm) }}
        {%- endfor -%}
    {%- elif original_list is none -%}
NULL
    {%- else -%}
{{ snowflake_safe_string(original_list | upper) }}
    {%- endif -%}
{%- endmacro %}

{#-
    Take a dictionary of key value pairs and produce the SQL fragment required
    for Snowflake TAG statements. When `set` is true, then produce the key = "value"
    list where there is a value. When `set` is false, then produce the list of keys
    that have no value.

    Example Usage:
        {{ support.tag_list({'key1': 'value','key2': 'value2','novalue': none})}}
        {{ support.tag_list({'key1': 'value','novalue': none,'missing': none}, false)}}
        {{ support.tag_list({'key1': 'value','novalue': ''}, false)}}

    Example Returns:
        KEY1 = $$value$$, KEY2 = $$value2$$
        NOVALUE, MISSING
        NOVALUE

-#}
{% macro tag_list(kv_dict, set=true) -%}
    {%- if set -%}
        {%- for key, value in kv_dict.items() if value -%}
            {%- if not loop.first %},
        {% endif -%} {#- for formatting -#}
            {{ key | upper }} = {{ snowflake_safe_string(value) }}
        {%- endfor -%}
    {%- else -%}
        {% for key, value in kv_dict.items() if not value -%}
            {{ key | upper }}{% if not loop.last %}, {% endif %}
        {%- endfor -%}
    {%- endif -%}
{%- endmacro %}

{#-
    Use a specific role in Snowflake and save the current role for restoration later.
    This macro is useful for switching roles in a controlled manner.

    Usage:
        {{ support.use_role('ANALYST_ROLE', 'SAVE_ROLE_PREVIOUS') }}

    This will set the current role to ANALYST_ROLE and save the previous role in SAVE_ROLE_PREVIOUS.
-#}
{% macro use_role(new_role, saverole) -%}
SET {{ saverole }} = CURRENT_ROLE();
USE ROLE {{ new_role }};
{%- endmacro %}

{#-
    Restore a previously saved role in Snowflake.
    This macro is used to revert back to the role that was saved earlier.

    Usage:
        {{ support.restore_role('SAVE_ROLE_PREVIOUS') }}

    This will set the current role back to the one stored in SAVE_ROLE_PREVIOUS.
-#}
{% macro restore_role(saverole) -%}
USE ROLE IDENTIFIER(${{ saverole }});
UNSET {{ saverole }};
{%- endmacro %}

{#-
    Attempt to raise an error in Snowflake SQL.
    This macro is used to generate an error message from an SQL query.

    Usage:
        {{ support.raise('This is an error message') }}

    This query cannot succeed. As a result, it will fail the current script and
    write a message to the effect of:
    "Can not convert parameter "error" of type [VARCHAR(n)] into expected type [ARRAY]"
    This is useful for debugging or enforcing conditions in your SQL scripts.
-#}
{% macro raise(error) %}
;
SELECT 'ERROR'
WHERE [] = {{snowflake_safe_string(error)}};
{% endmacro %}
