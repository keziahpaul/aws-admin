{% import 'modules/support.j2' as support with context -%}
{% import 'modules/fileformat.j2' as fileformat with context -%}

{#-
    This file is part of the Schemachange project.
    It provides macros for managing stages in Snowflake.

    Macros included:
        - name: Returns the name of the stage based on the environment, database, schema, and purpose.
        - legacy_name: Returns the legacy name of the stage based on the environment, database, schema, and purpose.
        - create_s3: Creates an S3 backed stage in Snowflake with the specified parameters.
        - drop: Drops the specified stage if it exists.
        - comment: Alters the comment on an existing stage.
        - tag: Tags the specified stage with a given tag.
        - grant_usage: Grants usage on the specified stage to a role.
        - revoke_usage: Revokes usage on the specified stage from a role.

    Privileges required?:
        CREATE STAGE
        USAGE ON STAGE
-#}

{#-
    Return the name of the stage based on the environment, database, schema, and purpose.
    This macro is used to create a consistent naming convention for stages across different environments.

    Preconditions:
        global var in_sf_env should be set to one of DEV, TST, PST, PRD
        db - the database this stage lives in, must be provided and not empty
        schema - the schema this stage lives in, must be provided and not empty
        purpose - the name you want to give the stage, must be provided and not empty

    Returns:
        A string in the format of <in_sf_env>_<db>.<schema>.<purpose>_STAGE, e.g., DEV_PROJECT.PART1.FILES_STAGE

    Raises:
        An error if in_sf_env is not set or not one of DEV, TST, PST, PRD
        An error if db is not provided or is empty
        An error if schema is not provided or is empty
        An error if purpose is not provided or is empty

    Example Usage:
        {{ stage.name('PROJECT', 'PART1', 'FILES') }}

    Example Returns:
        DEV_PROJECT.PART1.FILES_STAGE
-#}
{% macro name(db, schema, purpose) -%}
    {%- if not in_sf_env or in_sf_env | trim | upper not in ['DEV', 'TST', 'PST', 'PRD']  -%}
        {{ support.raise("in_sf_env must be one of DEV, TST, PST, PRD") }}
    {%- endif -%}
    {%- if not db or db | trim == "" -%}
        {{ support.raise("db must be provided to stage.name macro") }}
    {%- endif -%}
    {%- if not schema or schema | trim == "" -%}
        {{ support.raise("schema must be provided to stage.name macro") }}
    {%- endif -%}
    {%- if not purpose or purpose | trim == "" -%}
        {{ support.raise("purpose must be provided to stage.name macro") }}
    {%- endif -%}
    {{ in_sf_env | trim | upper }}_{{ db | trim | upper }}.{{ schema | trim | upper }}.{{ purpose | trim | upper }}_STAGE
{%- endmacro %}

{#-
    Return the legacy name of the stage based on the environment, database, schema, and purpose.
    This macro is used to create a consistent naming convention for stages across different environments.

    Preconditions:
        global var in_sf_env should be set to one of DEV, TST, PST, PRD
        db - the database this stage lives in, must be provided and not empty
        schema - the schema this stage lives in, must be provided and not empty
        purpose - the name you want to give the stage, must be provided and not empty

    Returns:
        A string in the format of <in_sf_env>_<db>.<schema>.<in_sf_env>_<purpose>_STAGE, e.g., DEV_PROJECT.PART1.DEV_FILES_STAGE

    Raises:
        An error if in_sf_env is not set or not one of DEV, TST, PST, PRD
        An error if db is not provided or is empty
        An error if schema is not provided or is empty
        An error if purpose is not provided or is empty

    Example Usage:
        {{ stage.name('PROJECT', 'PART1', 'FILES') }}

    Example Returns:
        DEV_PROJECT.PART1.DEV_FILES_STAGE
-#}
{% macro legacy_name(db, schema, purpose) -%}
    {%- if not in_sf_env or in_sf_env | trim | upper not in ['DEV', 'TST', 'PST', 'PRD']  -%}
        {{ support.raise("in_sf_env must be one of DEV, TST, PST, PRD") }}
    {%- endif -%}
    {%- if not db or db | trim == "" -%}
        {{ support.raise("db must be provided to stage.legacy_name macro") }}
    {%- endif -%}
    {%- if not schema or schema | trim == "" -%}
        {{ support.raise("schema must be provided to stage.legacy_name macro") }}
    {%- endif -%}
    {%- if not purpose or purpose | trim == "" -%}
        {{ support.raise("purpose must be provided to stage.legacy_name macro") }}
    {%- endif -%}
    {{ in_sf_env | trim | upper }}_{{ db | trim | upper }}.{{ schema | trim | upper }}.{{ in_sf_env | trim | upper }}_{{ purpose | trim | upper }}_STAGE
{%- endmacro %}

{#-
    Create an S3 backed stage in Snowflake with the specified parameters.
    This macro is used to create a stage that can be used for data loading or unloading.
    This is an opinionated macro that assumes you have already created a file format
    with the standard name based on the stage name.
    ie. DEV_PROJECT.PART1.FILES_STAGE expects DEV_PROJECT.PART1.FILES_FILE_FORMAT
    If the purpose is "logging" and we are using a DEV or TST environment, then it will
    adjust the bucket to a non-production S3 path by appending "-nonprod".

    Preconditions:
        db - The database where the stage will be created
        schema - The schema where the stage will be created
        purpose - A string indicating the purpose of the stage (e.g., logging)
        storage_int - The name of the storage integration to be used by this stage
        s3_bucket - The S3 bucket where data will be unloaded
        s3_key - The S3 key for the data
        kms_key_id - Optional KMS key ID for encryption
        comment - Optional comment for the stage
        tags - an optional dictionary of {tag: value} to set on the stage

    Returns:
        The SQL commands to create an S3 backed stage in Snowflake.

    Raises:
        An error if db, schema, purpose, storage_int, s3_bucket, or s3_key are not provided or are empty.
        An error if tags is provided and is not a dictionary

    Example Usage:
        {{ stage.create_s3('PROJECT', 'PART1', 'logging', 'my_storage_int', 'my_s3_bucket', 'my_s3_key', 'my_kms_key_id') }}
-#}
{% macro create_s3(db, schema, purpose, storage_int, s3_bucket, s3_key, kms_key_id=none, comment=none, tags={}) -%}
    {%- if not db or db | trim == "" -%}
        {{ support.raise("db must be provided to stage.create_s3 macro") }}
    {%- endif -%}
    {%- if not schema or schema | trim == "" -%}
        {{ support.raise("schema must be provided to stage.create_s3 macro") }}
    {%- endif -%}
    {%- if not purpose or purpose | trim == "" -%}
        {{ support.raise("purpose must be provided to stage.create_s3 macro") }}
    {%- endif -%}
    {%- if not storage_int or storage_int | trim == "" -%}
        {{ support.raise("storage_int must be provided to stage.create_s3 macro") }}
    {%- endif -%}
    {%- if not s3_bucket or s3_bucket | trim == "" -%}
        {{ support.raise("s3_bucket must be provided to stage.create_s3 macro") }}
    {%- endif -%}
    {%- if not s3_key or s3_key | trim == "" -%}
        {{ support.raise("s3_key must be provided to stage.create_s3 macro") }}
    {%- endif -%}
    {% if tags and not tags is mapping -%}
        {{ support.raise("tags must be provided as a dictionary to the stage.create_s3 macro") }}
    {%- endif -%}

    {%- if purpose | trim | upper == "LOGGING" and in_sf_env | trim | upper in ['DEV', 'TST'] -%}
        {%- set allowed_s3_path = "s3://" + (s3_bucket | trim) + "-nonprod/" + (s3_key | trim) -%}
    {%- else -%}
        {%- set allowed_s3_path = "s3://" + (s3_bucket | trim) + "/" + (s3_key | trim) -%}
    {%- endif -%}

{{ support.use_role('SYSADMIN', 'SAVE_ROLE_STAGE_CREATE') }}
CREATE STAGE {{ name(db, schema, purpose) }}
    STORAGE_INTEGRATION = {{ storage_int | trim }}
    URL = '{{ allowed_s3_path }}'
    {%- if kms_key_id and kms_key_id | trim != "" %}
    ENCRYPTION = (TYPE = 'AWS_SSE_KMS', KMS_KEY_ID = '{{kms_key_id | trim}}')
    {%- endif %}
    FILE_FORMAT = {{ fileformat.name(db, schema, purpose) }}
    {%- if comment %}
    COMMENT = {{ support.snowflake_safe_string(comment) }}
    {%- endif -%}
    {%- if tags -%}
        {%- set taglist -%}
            {{ support.tag_list(tags) }}
        {%- endset -%}
        {%- if taglist | trim %}
    TAG (
        {{ taglist }}
        )
        {%- endif -%}
    {%- endif -%}
    ;
{{ support.restore_role('SAVE_ROLE_STAGE_CREATE') }}
{%- endmacro %}

{#-
    Drop the specified stage if it exists.
    This macro is used to clean up stages that are no longer needed.

    Preconditions:
        db - The database where the stage exists
        schema - The schema where the stage exists
        purpose - The purpose of the stage

    Returns:
        The SQL command to drop the specified stage if it exists.

    Raises:
        An error if db, schema, or purpose are not provided or are empty.

    Example Usage:
        {{ stage.drop('PROJECT', 'PART1', 'FILES') }}

    Example Returns:
        DROP STAGE IF EXISTS DEV_PROJECT.PART1.FILES_STAGE;
-#}
{% macro drop(db, schema, purpose) -%}
{{ support.use_role('SYSADMIN', 'SAVE_ROLE_STAGE_DROP') }}
DROP STAGE IF EXISTS {{ name(db, schema, purpose) }};
{{ support.restore_role('SAVE_ROLE_STAGE_DROP') }}
{%- endmacro %}

{#-
    Alter the comment on an existing stage.
    This macro is used to add or update a comment on a stage.

    Preconditions:
        db - The database where the stage exists
        schema - The schema where the stage exists
        purpose - The purpose of the stage
        comment - The comment to be set on the stage (optional, can be empty)

    Returns:
        The SQL command to alter the comment on the specified stage.

    Raises:
        An error if db, schema, or purpose are not provided or are empty.

    Example Usage:
        {{ stage.comment('PROJECT', 'PART1', 'FILES', 'This is a test stage') }}
        {{ stage.comment('PROJECT', 'PART1', 'FILES', ) }}

    Example Returns:
        ALTER STAGE DEV_PROJECT.PART1.FILES_STAGE SET COMMENT $$This is a test stage$$;
        ALTER STAGE DEV_PROJECT.PART1.FILES_STAGE UNSET COMMENT;
-#}
{% macro comment(db, schema, purpose, comment=none) -%}
{{ support.use_role('SYSADMIN', 'SAVE_ROLE_STAGE_COMMENT') }}
    {%- if comment %}
ALTER STAGE {{ name(db, schema, purpose) }}
    SET COMMENT {{ support.snowflake_safe_string(comment) }};
    {%- else %}
ALTER STAGE {{ name(db, schema, purpose) }}
    UNSET COMMENT;
    {%- endif %}
{{ support.restore_role('SAVE_ROLE_STAGE_COMMENT') }}
{%- endmacro %}

{#-
    Alter the tag on an existing stage.
    This macro is used to add or update a tag on a stage.

    Preconditions:
        db - The database where the stage exists
        schema - The schema where the stage exists
        purpose - The purpose of the stage
        tags - a dictionary of {tag: value} to set/unset on the stage

    Returns:
        The SQL command to alter the tag on the specified stage.

    Raises:
        An error if db, schema, or purpose is not provided or is empty.
        An error if tags is not a dictionary

    Example Usage:
        {{ stage.tag('PROJECT', 'PART1', 'FILES', {'ENVIRONMENT': 'PRODUCTION'}) }}
        {{ stage.tag('PROJECT', 'PART1', 'FILES', {'ENVIRONMENT': none}) }}

    Example Returns:
        ALTER STAGE DEV_PROJECT.PART1.FILES_STAGE SET TAG ENVIRONMENT = $$PRODUCTION$$;
        ALTER STAGE DEV_PROJECT.PART1.FILES_STAGE UNSET TAG ENVIRONMENT;
-#}
{% macro tag(db, schema, purpose, tags) -%}
    {%- if tags and not tags is mapping -%}
        {{ support.raise("tags must be provided as a dictionary to the stage.tag macro") }}
    {%- endif -%}
    {%- set addtaglist -%}
        {{ support.tag_list(tags) }}
    {%- endset -%}
    {%- set deltaglist -%}
        {{ support.tag_list(tags, false) }}
    {%- endset -%}
    {%- if addtaglist | trim or deltaglist | trim -%}
{{ support.use_role('SYSADMIN', 'SAVE_ROLE_STAGE_TAG') }}
        {%- if addtaglist | trim %}
ALTER STAGE {{ name(db, schema, purpose) }}
    SET TAG {{ addtaglist }};
        {%- endif -%}
        {%- if deltaglist | trim %}
ALTER STAGE {{ name(db, schema, purpose) }}
    UNSET TAG {{ deltaglist }};
        {%- endif %}
{{ support.restore_role('SAVE_ROLE_STAGE_TAG') }}
    {%- endif -%}
{%- endmacro %}

{#-
    Grant usage on the specified stage to a role.
    This macro is used to allow a role to access the stage for data loading or unloading.

    Preconditions:
        db - The database where the stage exists
        schema - The schema where the stage exists
        purpose - The purpose of the stage
        role - The role to which usage is being granted
        isdbrole - A boolean indicating if the role is a database role (optional, defaults to false)

    Returns:
        The SQL command to grant usage on the stage to the specified role.

    Raises:
        An error if db, schema, purpose, or role are not provided or are empty.

    Example Usage:
        {{ stage.grant_usage('PROJECT', 'PART1', 'FILES', 'ANALYST_ROLE') }}
        {{ stage.grant_usage('PROJECT', 'PART1', 'FILES', 'ANALYST_ROLE', true) }}

    Example Returns:
        GRANT USAGE ON STAGE DEV_PROJECT.PART1.FILES_STAGE TO ROLE ANALYST_ROLE;
        GRANT USAGE ON STAGE DEV_PROJECT.PART1.FILES_STAGE TO DATABASE ROLE ANALYST_ROLE;
-#}
{% macro grant_usage(db, schema, purpose, role, isdbrole=false) -%}
    {%- if not role or role | trim == "" -%}
        {{ support.raise("role must be provided to stage.grant_usage macro") }}
    {%- else -%}
        {%- set role = "ROLE " + role | trim | upper -%}
    {%- endif -%}
    {%- if isdbrole -%}
        {%- set role = "DATABASE " + role -%}
    {%- endif -%}
{{ support.use_role('SECURITYADMIN', 'SAVE_ROLE_GRANT') }}
GRANT USAGE ON STAGE {{ name(db, schema, purpose) }} TO {{ role }};
{{ support.restore_role('SAVE_ROLE_GRANT') }}
{%- endmacro %}

{#-
    Revoke usage on the specified stage from a role.
    This macro is used to remove access to the stage for a specific role.

    Preconditions:
        db - The database where the stage exists
        schema - The schema where the stage exists
        purpose - The purpose of the stage
        role - The role from which usage is being revoked
        isdbrole - A boolean indicating if the role is a database role (optional, defaults to false)

    Returns:
        The SQL command to revoke usage on the stage from the specified role.

    Raises:
        An error if db, schema, purpose, or role are not provided or are empty.

    Example Usage:
        {{ stage.revoke_usage('PROJECT', 'PART1', 'FILES', 'ANALYST_ROLE') }}
        {{ stage.revoke_usage('PROJECT', 'PART1', 'FILES', 'ANALYST_ROLE', true) }}

    Example Returns:
        REVOKE USAGE ON STAGE DEV_PROJECT.PART1.FILES_STAGE FROM ROLE ANALYST_ROLE;
        REVOKE USAGE ON STAGE DEV_PROJECT.PART1.FILES_STAGE FROM DATABASE ROLE ANALYST_ROLE;
-#}
{% macro revoke_usage(db, schema, purpose, role, isdbrole=false) -%}
    {%- if not role or role | trim == "" -%}
        {{ support.raise("role must be provided to stage.revoke_usage macro") }}
    {%- else -%}
        {%- set role = "ROLE " + role | trim | upper -%}
    {%- endif -%}
    {%- if isdbrole -%}
        {%- set role = "DATABASE " + role -%}
    {%- endif -%}
{{ support.use_role('SECURITYADMIN', 'SAVE_ROLE_REVOKE') }}
REVOKE USAGE ON STAGE {{ name(db, schema, purpose) }} FROM {{ role }};
{{ support.restore_role('SAVE_ROLE_REVOKE') }}
{%- endmacro %}
