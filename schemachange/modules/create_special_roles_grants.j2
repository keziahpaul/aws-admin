grant all privileges                        on               schema             {{ db_schema }} to database role {{ di_db_writer_role }} ;
grant all privileges                        on all tables             in schema {{ db_schema }} to database role {{ di_db_writer_role }} ;
grant all privileges                        on all views              in schema {{ db_schema }} to database role {{ di_db_writer_role }} ;
grant all privileges                        on all materialized views in schema {{ db_schema }} to database role {{ di_db_writer_role }};
grant all privileges                        on all procedures         in schema {{ db_schema }} to database role {{ di_db_writer_role }};
grant all privileges                        on all functions          in schema {{ db_schema }} to database role {{ di_db_writer_role }};
grant all privileges                        on all sequences          in schema {{ db_schema }} to database role {{ di_db_writer_role }};

{# reader role grants #}
        grant usage                            on database                                   {{ db_name }}     to database role {{ di_db_reader_role }};
        grant usage                            on schema                                     {{ db_schema }} to database role {{ di_db_reader_role }};
        grant select, references               on all tables             in schema {{ db_schema }} to database role {{ di_db_reader_role }};
        grant select, references               on all views              in schema {{ db_schema }} to database role {{ di_db_reader_role }};
        grant select, references               on all materialized views in schema {{ db_schema }} to database role {{ di_db_reader_role }};
        grant usage                            on all procedures         in schema {{ db_schema }} to database role {{ di_db_reader_role }};
        grant usage                            on all functions          in schema {{ db_schema }} to database role {{ di_db_reader_role }};

{% elif db_schema.lower().endswith('ds_sandbox') %}

{# writer role to #}

grant database role      {{ ds_db_writer_role }}       to role     {{ in_sf_env }}_DATA_SCIENTIST_PUBLIC_F;
