grant ownership                        on all tables             in schema {{ db_schema }} to database role {{ di_db_writer_role }} revoke current grants;
grant ownership                        on all views              in schema {{ db_schema }} to database role {{ di_db_writer_role }} revoke current grants;
grant ownership                        on all materialized views in schema {{ db_schema }} to database role {{ di_db_writer_role }} revoke current grants;    
grant ownership                        on all procedures         in schema {{ db_schema }} to database role {{ di_db_writer_role }} revoke current grants;
