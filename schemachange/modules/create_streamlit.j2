
{% macro create_streamlit(in_sf_env, database, schema, app, tag_value, wh_grant_role) -%}
{# app is an snowflake streamlit app taht needs to be created#}
{# tagvalue is a value that needs to be assigned to the streamlit warehouse}#}
{# wh_grant_role is a role which needs access to the streamlit warehouse#}


{% from 'modules/create_warehouse.j2' import create_warehouse-%}


{% set streamlit_database = in_sf_env + "_"+database %}
{% set streamlit_schema = schema %}
{% set streamlit_app = app %}
-- Choose one of the tag values below to set it to the warehouse
-- ( 'Account management','Account management practitioners','Pexa products','Pexa features','Customer support','Marketing','Enterprise','Data engineering','Data science' )
--role that needs access to the new warehouse
{% set grant_role = in_sf_env +"_"+wh_grant_role %}


--derived variables----
{% set streamlit_app_wh = streamlit_app+"_xs_sa" %}
{% set env_full_streamlit_app_wh = in_sf_env+"_"+streamlit_app_wh+"_wh" %}
{% set streamlit_stage = streamlit_database+'.'+streamlit_schema+'.'+in_sf_env + "_streamlit_apps" %}
{% set streamlit_stage_location = streamlit_database+'.'+streamlit_schema+'.'+in_sf_env + "_streamlit_apps/"+streamlit_app %}
{% set tag_db_schema = in_sf_env + "_governance_db.compliance" %}

use role sysadmin;
grant create streamlit on schema {{streamlit_database}}.{{streamlit_schema}} to role {{grant_role}};

--dev_ssa_dbt_integration_role_s also owns dev_streamlit_apps stage--
grant read,write on stage {{streamlit_stage}} to role {{grant_role}};

--creating  warehouse for streamlit app
use role sysadmin;
{{create_warehouse(in_sf_env,streamlit_app_wh,'XSMALL',1,60,'This warehouse used by dbt_cloud_api streamli app')}}

alter warehouse {{env_full_streamlit_app_wh}} set tag {{tag_db_schema}}.streamlit= '{{tag_value}}';

--grant usage access to warehouse
use role securityadmin;
grant usage on warehouse {{env_full_streamlit_app_wh}} to role {{grant_role}};

use role {{grant_role}};

--create streamlit
create streamlit if not exists {{streamlit_database}}.{{streamlit_schema}}.{{ streamlit_app }} root_location = '@{{streamlit_stage_location}}' main_file = '/streamlit_main.py'
query_warehouse = {{env_full_streamlit_app_wh}};

alter streamlit if exists {{streamlit_database}}.{{streamlit_schema}}.{{ streamlit_app }}
set root_location = '@{{streamlit_stage_location}}'
    query_warehouse = {{env_full_streamlit_app_wh}};





{%- endmacro %}