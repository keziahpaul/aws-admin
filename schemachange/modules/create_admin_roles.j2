{% macro create_admin_roles(in_sf_env,in_sf_acc_name,params_dict) -%}
{# in_sf_env is an environment prefix {{ in_sf_env }}#}
{# in_sf_acc_name is an snowflake account name variable#}


{%set key_serviceusers=['DBT','FIVETRAN','GITHUB','ALATION','TABLEAU','SAGEMAKER','BIGID']%}
use role useradmin;
{# --------------------------------ccreate services integration users ------------------------------------------------------------------ #}
    create user if not exists {{ in_sf_env }}_GITHUB_INTEGRATION_USER;
    create user if not exists {{ in_sf_env }}_DBT_INTEGRATION_USER;
    create user if not exists {{ in_sf_env }}_FIVETRAN_INTEGRATION_USER;
    create user if not exists {{ in_sf_env }}_CENSUS_INTEGRATION_USER;
    create user if not exists {{ in_sf_env }}_ALATION_INTEGRATION_USER;
    create user if not exists {{ in_sf_env }}_TABLEAU_INTEGRATION_USER;
    create user if not exists {{ in_sf_env }}_SAGEMAKER_INTEGRATION_USER;
    create user if not exists {{ in_sf_env }}_BIGID_INTEGRATION_USER;
    create user if not exists {{ in_sf_env }}_SLACK_INTEGRATION_USER;
    {% if (in_sf_env.lower() == 'dev')%}
        create user if not exists {{ in_sf_env }}_SLACK_JOB_NOTIFICATION_USER ;
        alter user {{ in_sf_env }}_SLACK_JOB_NOTIFICATION_USER set EMAIL = {{ params_dict['dev_onedata_alert_slack_email'] }} ;
        alter user {{ in_sf_env }}_SLACK_JOB_NOTIFICATION_USER set password = null ;
    {% elif (in_sf_env.lower() == 'prd') %}
        create user if not exists {{ in_sf_env }}_SLACK_JOB_NOTIFICATION_USER ;
        alter user {{ in_sf_env }}_SLACK_JOB_NOTIFICATION_USER set EMAIL = {{ params_dict['prd_onedata_alert_slack_email'] }} ;
        alter user {{ in_sf_env }}_SLACK_JOB_NOTIFICATION_USER set password = null ;
    {%endif%}


    alter user {{ in_sf_env }}_SLACK_INTEGRATION_USER set EMAIL = {{ params_dict['alert_slack_email'] }} ;

    {% for  serviceuser in key_serviceusers %}
        ALTER USER {{ in_sf_env }}_{{serviceuser}}_INTEGRATION_USER
        SET TYPE = 'SERVICE';
    {%endfor%}

    {% for  serviceuser in key_serviceusers %}
        {% if env_var('SNOWFLAKE_'~serviceuser~'_PUBLIC_KEY','')!= '' %}
            ALTER USER {{ in_sf_env }}_{{serviceuser}}_INTEGRATION_USER
            SET RSA_PUBLIC_KEY = '{{env_var('SNOWFLAKE_'~serviceuser~'_PUBLIC_KEY','')}}';
        {%endif%}
    {%endfor%}



use role securityadmin;
{# --------------------------------create admin Roles ---------------------------------------------------------------------------------- #}
    create role if not exists {{ in_sf_env }}_DATA_GOVERNANCE_ADMIN;
    create role if not exists  {{ in_sf_env }}_DATABASE_ADMIN;



{# --------------------------------create Services Roles ------------------------------------------------------------------------------- #}
    create role if not exists {{ in_sf_env }}_GITHUB_INTEGRATION_ROLE_S;
    create role if not exists {{ in_sf_env }}_ALATION_INTEGRATION_ROLE_S;
    create role if not exists {{ in_sf_env }}_FIVETRAN_INTEGRATION_ROLE_S;
    create role if not exists {{ in_sf_env }}_DBT_INTEGRATION_ROLE_S;
    create role if not exists {{ in_sf_env }}_CENSUS_INTEGRATION_ROLE_S;
    create role if not exists {{ in_sf_env }}_TABLEAU_INTEGRATION_ROLE_S;
    create role if not exists {{ in_sf_env }}_SAGEMAKER_INTEGRATION_ROLE_S;
    create role if not exists {{ in_sf_env }}_BIGID_INTEGRATION_ROLE_S;




{# --------------------------------grant service roles to service users ---------------------------------------------------------------- #}
    grant role {{ in_sf_env }}_GITHUB_INTEGRATION_ROLE_S TO USER {{ in_sf_env }}_GITHUB_INTEGRATION_USER;
    grant role {{ in_sf_env }}_DBT_INTEGRATION_ROLE_S TO USER {{ in_sf_env }}_DBT_INTEGRATION_USER;
    grant role {{ in_sf_env }}_FIVETRAN_INTEGRATION_ROLE_S TO USER {{ in_sf_env }}_FIVETRAN_INTEGRATION_USER;
    grant role {{ in_sf_env }}_CENSUS_INTEGRATION_ROLE_S TO USER {{ in_sf_env }}_CENSUS_INTEGRATION_USER;
    grant role {{ in_sf_env }}_ALATION_INTEGRATION_ROLE_S TO USER {{ in_sf_env }}_ALATION_INTEGRATION_USER;
    grant role {{ in_sf_env }}_TABLEAU_INTEGRATION_ROLE_S TO USER {{ in_sf_env }}_TABLEAU_INTEGRATION_USER;
    grant role {{ in_sf_env }}_SAGEMAKER_INTEGRATION_ROLE_S TO USER {{ in_sf_env }}_SAGEMAKER_INTEGRATION_USER;
    grant role {{ in_sf_env }}_BIGID_INTEGRATION_ROLE_S TO USER {{ in_sf_env }}_BIGID_INTEGRATION_USER;


{# --------------------------------grant roles to github integration role---------------------------------------------------------------- #}

    grant role sysadmin to role {{ in_sf_env }}_github_integration_role_s;
    grant role securityadmin to role {{ in_sf_env }}_github_integration_role_s;
    grant role useradmin to role {{ in_sf_env }}_github_integration_role_s;  

{#  ------------------------------grant priviliges to sysadmin----------------------------------------------------------------------------- #}
    grant role security_network_admin to role sysadmin;



{#  ------------------------------grant usage on schemachange db, schema, table----------------------------------------------------------------------------- #}
    grant usage on database {{ in_sf_env }}_metadata to role {{ in_sf_env }}_GITHUB_INTEGRATION_ROLE_S;
    grant usage on schema {{ in_sf_env }}_metadata.schemachange to role {{ in_sf_env }}_GITHUB_INTEGRATION_ROLE_S;
    grant select, insert, update, delete, truncate on table {{ in_sf_env }}_metadata.schemachange.change_history to role {{ in_sf_env }}_GITHUB_INTEGRATION_ROLE_S;

{# -------------------------------For documentation purposes ONLY, this was created manually in snowflake worksheet----------------------- #}
    create role if not exists OKTA_PROVISIONER;
    create role if not exists {{ in_sf_env }}_ANALYST_F;
    create role if not exists {{ in_sf_env }}_ENGINEER_F;
    create role if not exists {{ in_sf_env }}_DI_ANALYST_F;
    create role if not exists {{ in_sf_env }}_SUPPORT_F;
    create role if not exists {{ in_sf_env }}_SCIENTIST_F;
    create role if not exists {{ in_sf_env }}_DATA_STEWARD_F;
    create role if not exists {{ in_sf_env }}_DATA_GOVERNANCE_SPECIALIST_F;

{# -------------------------------secops role to access security dashboard----------------------- #}
    create role if not exists SECOPS_F;
    grant role securityadmin to role SECOPS_F;

{# -------------------------------grant services roles to sysadmin----------------------- #}
    revoke role {{ in_sf_env }}_DBT_INTEGRATION_ROLE_S from role sysadmin;
    grant role sysadmin to role {{ in_sf_env }}_DBT_INTEGRATION_ROLE_S;

    revoke role {{ in_sf_env }}_FIVETRAN_INTEGRATION_ROLE_S from role sysadmin;
    grant role sysadmin to role {{ in_sf_env }}_FIVETRAN_INTEGRATION_ROLE_S;

 {# -------------------------------grant functional roles to sysadmin----------------------- #}
    grant role {{ in_sf_env }}_ANALYST_F to role sysadmin;
    grant role {{ in_sf_env }}_ENGINEER_F to role sysadmin;
    grant role {{ in_sf_env }}_DI_ANALYST_F to role sysadmin;
    grant role {{ in_sf_env }}_SUPPORT_F to role sysadmin;
    grant role {{ in_sf_env }}_SCIENTIST_F to role sysadmin;
    grant role {{ in_sf_env }}_DATA_STEWARD_F to role sysadmin;
    grant role {{ in_sf_env }}_DATA_GOVERNANCE_SPECIALIST_F to role sysadmin;



{# -------------------------------grant privileges to engineer_f ----------------------- #}

    grant usage on database {{ in_sf_env }}_metadata to role {{ in_sf_env }}_ENGINEER_F;
    grant usage on schema {{ in_sf_env }}_metadata.schemachange to role {{ in_sf_env }}_ENGINEER_F;
    grant select, references on all tables  in schema {{ in_sf_env }}_metadata.schemachange to role {{ in_sf_env }}_ENGINEER_F;

{# -------------------------------grant privileges to support_f ----------------------- #}

    grant usage on database {{ in_sf_env }}_metadata to role {{ in_sf_env }}_SUPPORT_F;
    grant usage on schema {{ in_sf_env }}_metadata.schemachange to role {{ in_sf_env }}_SUPPORT_F;
    grant select, references on all tables  in schema {{ in_sf_env }}_metadata.schemachange to role {{ in_sf_env }}_SUPPORT_F;

{#  ------------------------------Grants to view snowflake database--------------------------------------------------------------------------------------------- #}
use role accountadmin;

    grant database role SNOWFLAKE.OBJECT_VIEWER to role {{ in_sf_env }}_ALATION_INTEGRATION_ROLE_S;
    grant database role SNOWFLAKE.GOVERNANCE_VIEWER to role {{ in_sf_env }}_ALATION_INTEGRATION_ROLE_S;
    grant database role SNOWFLAKE.USAGE_VIEWER to role {{ in_sf_env }}_ALATION_INTEGRATION_ROLE_S;


    grant database role SNOWFLAKE.OBJECT_VIEWER to role {{ in_sf_env }}_DBT_INTEGRATION_ROLE_S;
    grant database role SNOWFLAKE.GOVERNANCE_VIEWER to role {{ in_sf_env }}_DBT_INTEGRATION_ROLE_S;
    grant database role SNOWFLAKE.USAGE_VIEWER to role {{ in_sf_env }}_DBT_INTEGRATION_ROLE_S;
    grant database role SNOWFLAKE.SECURITY_VIEWER to role {{ in_sf_env }}_DBT_INTEGRATION_ROLE_S;


    grant database role SNOWFLAKE.GOVERNANCE_VIEWER to role SECOPS_F;
    grant database role SNOWFLAKE.SECURITY_VIEWER to role SECOPS_F;

    grant database role SNOWFLAKE.GOVERNANCE_VIEWER to role {{ in_sf_env }}_ANALYST_F;
    grant database role SNOWFLAKE.GOVERNANCE_VIEWER to role {{ in_sf_env }}_ENGINEER_F;
    grant database role SNOWFLAKE.GOVERNANCE_VIEWER to role {{ in_sf_env }}_DI_ANALYST_F;
    grant database role SNOWFLAKE.GOVERNANCE_VIEWER to role {{ in_sf_env }}_SUPPORT_F;
    grant database role SNOWFLAKE.GOVERNANCE_VIEWER to role {{ in_sf_env }}_SCIENTIST_F;
    grant database role SNOWFLAKE.GOVERNANCE_VIEWER to role {{ in_sf_env }}_DATA_GOVERNANCE_SPECIALIST_F;
    grant database role SNOWFLAKE.GOVERNANCE_VIEWER to role {{ in_sf_env }}_DATA_STEWARD_F;
    

    grant database role SNOWFLAKE.OBJECT_VIEWER to role {{ in_sf_env }}_ANALYST_F;
    grant database role SNOWFLAKE.OBJECT_VIEWER to role {{ in_sf_env }}_ENGINEER_F;
    grant database role SNOWFLAKE.OBJECT_VIEWER to role {{ in_sf_env }}_DI_ANALYST_F;
    grant database role SNOWFLAKE.OBJECT_VIEWER to role {{ in_sf_env }}_SUPPORT_F;
    grant database role SNOWFLAKE.OBJECT_VIEWER to role {{ in_sf_env }}_SCIENTIST_F;
    grant database role SNOWFLAKE.OBJECT_VIEWER to role {{ in_sf_env }}_DATA_GOVERNANCE_SPECIALIST_F;
    grant database role SNOWFLAKE.OBJECT_VIEWER to role {{ in_sf_env }}_DATA_STEWARD_F;
    

    grant imported privileges on database snowflake to role sysadmin;
    grant imported privileges on database snowflake to role securityadmin;

{#  ------------------------------Grants to view snowflake trustcenter findings-------------------------------------------------------------------------- #}
    grant application role SNOWFLAKE.TRUST_CENTER_VIEWER to role {{ in_sf_env }}_DBT_INTEGRATION_ROLE_S;
    grant application role SNOWFLAKE.TRUST_CENTER_VIEWER to role {{ in_sf_env }}_ENGINEER_F;
    grant application role SNOWFLAKE.TRUST_CENTER_VIEWER to role {{ in_sf_env }}_SUPPORT_F;

{# --------------------------------data retention time for time travel ------------------------------------------------------------------ #}
    {% if (in_sf_env).lower() == 'dev' %}
        alter account set MIN_DATA_RETENTION_TIME_IN_DAYS=0 ;
        alter account set DATA_RETENTION_TIME_IN_DAYS=0 ;
    {% elif (in_sf_env).lower() == 'prd' %}
        alter account set MIN_DATA_RETENTION_TIME_IN_DAYS=1 ;
        alter account set DATA_RETENTION_TIME_IN_DAYS=1 ;
    {% endif %}

{# --------------------------------to enable query history to show failed query ------------------------------------------------------------------ #}
    alter account set enable_unredacted_query_syntax_error=true;


{# --------------------------------creating glue user ------------------------------------------------------------------ #}
    {% if ((in_sf_acc_name).lower() == 'value-australia' or (in_sf_acc_name).lower() == 'sandbox' ) %}
    use role useradmin;
    create user if not exists {{ in_sf_env }}_GLUE_INTEGRATION_USER;
    --assigning public key generated from other workflow
    ALTER USER {{ in_sf_env }}_GLUE_INTEGRATION_USER
    SET RSA_PUBLIC_KEY = '{{env_var('SNOWFLAKE_GLUE_PUBLIC_KEY','')}}';

    ALTER USER {{ in_sf_env }}_GLUE_INTEGRATION_USER
    SET TYPE = 'SERVICE';

    use role securityadmin;
    create role if not exists {{ in_sf_env }}_GLUE_INTEGRATION_ROLE_S;
    grant role {{ in_sf_env }}_GLUE_INTEGRATION_ROLE_S TO USER {{ in_sf_env }}_GLUE_INTEGRATION_USER;

    use role accountadmin;
    grant database role SNOWFLAKE.OBJECT_VIEWER to role {{ in_sf_env }}_GLUE_INTEGRATION_ROLE_S;
    grant database role SNOWFLAKE.GOVERNANCE_VIEWER to role {{ in_sf_env }}_GLUE_INTEGRATION_ROLE_S;
    grant database role SNOWFLAKE.USAGE_VIEWER to role {{ in_sf_env }}_GLUE_INTEGRATION_ROLE_S;
    grant database role SNOWFLAKE.SECURITY_VIEWER to role {{ in_sf_env }}_GLUE_INTEGRATION_ROLE_S;

    grant usage on warehouse {{ in_sf_env }}_GLUE_XS_WH to role {{ in_sf_env }}_GLUE_INTEGRATION_ROLE_S;
    grant usage on warehouse {{ in_sf_env }}_GLUE_S_WH to role {{ in_sf_env }}_GLUE_INTEGRATION_ROLE_S;
    grant usage on warehouse {{ in_sf_env }}_GLUE_M_WH to role {{ in_sf_env }}_GLUE_INTEGRATION_ROLE_S;
    ALTER USER {{ in_sf_env }}_GLUE_INTEGRATION_USER SET DEFAULT_WAREHOUSE = {{ in_sf_env }}_GLUE_XS_WH;
    {% endif %}



{# --------------------------------creating new dbt user and role for analytics project in group account ------------------------------------------------------------------ #}
    {% if ((in_sf_acc_name).lower() == 'group'  or (in_sf_acc_name).lower() == 'sandbox' ) %}
    use role useradmin;
    create user if not exists {{ in_sf_env }}_SSA_DBT_INTEGRATION_USER;
    --assigning public key generated from other workflow
    ALTER USER {{ in_sf_env }}_SSA_DBT_INTEGRATION_USER
    SET RSA_PUBLIC_KEY = '{{env_var('SNOWFLAKE_SSA_DBT_PUBLIC_KEY','')}}';

    ALTER USER {{ in_sf_env }}_SSA_DBT_INTEGRATION_USER
    SET TYPE = 'SERVICE';

    use role securityadmin;
    create role if not exists {{ in_sf_env }}_SSA_DBT_INTEGRATION_ROLE_S;
    grant role {{ in_sf_env }}_SSA_DBT_INTEGRATION_ROLE_S TO USER {{ in_sf_env }}_SSA_DBT_INTEGRATION_USER;

    use role accountadmin;
    grant database role SNOWFLAKE.OBJECT_VIEWER to role {{ in_sf_env }}_SSA_DBT_INTEGRATION_ROLE_S;
    grant database role SNOWFLAKE.GOVERNANCE_VIEWER to role {{ in_sf_env }}_SSA_DBT_INTEGRATION_ROLE_S;
    grant database role SNOWFLAKE.USAGE_VIEWER to role {{ in_sf_env }}_SSA_DBT_INTEGRATION_ROLE_S;
    grant database role SNOWFLAKE.SECURITY_VIEWER to role {{ in_sf_env }}_SSA_DBT_INTEGRATION_ROLE_S;

    grant usage on warehouse {{ in_sf_env }}_TRN_XS_WH to role {{ in_sf_env }}_SSA_DBT_INTEGRATION_ROLE_S;
    grant usage on warehouse {{ in_sf_env }}_TRN_S_WH to role {{ in_sf_env }}_SSA_DBT_INTEGRATION_ROLE_S;
    grant usage on warehouse {{ in_sf_env }}_TRN_M_WH to role {{ in_sf_env }}_SSA_DBT_INTEGRATION_ROLE_S;

    revoke role {{ in_sf_env }}_SSA_DBT_INTEGRATION_ROLE_S from role sysadmin;
    grant role sysadmin to role {{ in_sf_env }}_SSA_DBT_INTEGRATION_ROLE_S;

    ALTER USER {{ in_sf_env }}_SSA_DBT_INTEGRATION_USER SET DEFAULT_WAREHOUSE = {{ in_sf_env }}_TRN_XS_WH;
    ALTER USER {{ in_sf_env }}_SSA_DBT_INTEGRATION_USER SET NETWORK_POLICY = enabled_dbt_IPV4_network ;

{# --------------------------------creating new tableau user with key pair for DI tableau reporta  ------------------------------------------------------------------ #}

    use role useradmin;
    create user if not exists {{ in_sf_env }}_TABLEAU_DATASOURCE_INTEGRATION_USER 
    TYPE = SERVICE
    DEFAULT_ROLE = {{ in_sf_env }}_TABLEAU_INTEGRATION_ROLE_S
    DEFAULT_WAREHOUSE = {{ in_sf_env }}_TABLEAU_XS_WH;


    --assigning public key generated from other workflow
    ALTER USER {{ in_sf_env }}_TABLEAU_DATASOURCE_INTEGRATION_USER
    SET RSA_PUBLIC_KEY = '{{env_var('SNOWFLAKE_TABLEAU_PUBLIC_KEY','')}}';

    use role securityadmin;
    grant role {{ in_sf_env }}_TABLEAU_INTEGRATION_ROLE_S to USER {{ in_sf_env }}_TABLEAU_DATASOURCE_INTEGRATION_USER;

    use role accountadmin;
    ALTER USER {{ in_sf_env }}_TABLEAU_DATASOURCE_INTEGRATION_USER SET NETWORK_POLICY = ENABLED_TABLEAU_IPV4_NETWORK ;
    {% endif %}

{# --------------------------------creating BigID user and role for data classification ------------------------------------------------------------------ #}
    use role accountadmin;
    grant database role SNOWFLAKE.OBJECT_VIEWER to role {{ in_sf_env }}_BIGID_INTEGRATION_ROLE_S;
    grant database role SNOWFLAKE.GOVERNANCE_VIEWER to role {{ in_sf_env }}_BIGID_INTEGRATION_ROLE_S;

    {% if ((in_sf_acc_name).lower() != 'exchange' ) %}
    {# -------------------------------adding speicals role to access unmasked data----------------------- #}    
    create role if not exists {{ in_sf_env }}_DI_ANALYST_PUBLIC_F;
    create role if not exists {{ in_sf_env }}_DATA_SCIENTIST_PUBLIC_F;

    {# -------------------------------adding speicals role to access unmasked data----------------------- #}  
    grant role {{ in_sf_env }}_DI_ANALYST_PUBLIC_F to role sysadmin;
    grant role {{ in_sf_env }}_DATA_SCIENTIST_PUBLIC_F to role sysadmin;

    grant database role SNOWFLAKE.OBJECT_VIEWER to role {{ in_sf_env }}_DI_ANALYST_PUBLIC_F;
    grant database role SNOWFLAKE.OBJECT_VIEWER to role {{ in_sf_env }}_DATA_SCIENTIST_PUBLIC_F;
    grant database role SNOWFLAKE.GOVERNANCE_VIEWER to role {{ in_sf_env }}_DI_ANALYST_PUBLIC_F;
    grant database role SNOWFLAKE.GOVERNANCE_VIEWER to role {{ in_sf_env }}_DATA_SCIENTIST_PUBLIC_F;

    {% endif %}


{% endmacro %}

