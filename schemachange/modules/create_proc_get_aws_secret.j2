{% macro create_proc_get_aws_secret(in_sf_env) -%}

use role securityadmin;
grant role accountadmin to role {{in_sf_env}}_github_integration_role_s;

use role accountadmin;
use database {{in_sf_env}}_GOVERNANCE_DB;
use schema COMPLIANCE;

{#
-- Usage: 
    in_sf_env is an environment prefix {{ in_sf_env }}
-- Example: {{create_proc_get_aws_secret(in_sf_env)}};
-- secret_name is fully qualified 'DEV_GROUP_RAW.GENESYS.GENESYS_CREDENTIALS'
-- This procedure fetches a secret from AWS Secrets Manager and updates the corresponding Snowflake secret.
-- The AWS secret ID is derived as: one_data_snowflake_<env>_<secret_name>
-- The Snowflake secret is updated at: <database>.<schema>.<secret_name> #}

CREATE OR REPLACE PROCEDURE {{in_sf_env}}_GOVERNANCE_DB.COMPLIANCE.get_aws_secret(
    secret_name STRING
)
  RETURNS VARIANT
  LANGUAGE PYTHON
  RUNTIME_VERSION = '3.11'
  PACKAGES = ('snowflake-snowpark-python', 'boto3')
  HANDLER = 'main'
  EXTERNAL_ACCESS_INTEGRATIONS = (aws_secretsmanager_integration)
  SECRETS = ('cred' = {{in_sf_env}}_GOVERNANCE_DB.COMPLIANCE.aws_secretsmanager_token)
AS
$$
import _snowflake
from snowflake.snowpark.exceptions import SnowparkSQLException
import boto3
import json
from botocore.config import Config
from botocore.exceptions import ClientError

def aws_secret_transform(database_name, schema_name, secret_name):
    # Derive the env from the database name (e.g., DEV_GROUP_RAW -> dev)
    env = database_name.split('_')[0].lower()
    aws_secret_id = f"one_data_snowflake_{env}_{secret_name.lower()}"
    return aws_secret_id

def main(session, secret_name):
    try:
        cloud_provider_object = _snowflake.get_cloud_provider_token('cred')
    except Exception as e:
        raise Exception(f'Failed to get cloud provider token: {str(e)}')

    try:
        secret = session.sql("DESCRIBE SECRET IDENTIFIER(?)", params=[secret_name]).collect()
    except SnowparkSQLException as e:
        raise Exception(f'Secret does not exist in Snowflake: {str(e)}')

    found_database = secret[0]["database_name"]
    found_schema = secret[0]["schema_name"]
    found_secret = secret[0]["name"]
    aws_secret_id = aws_secret_transform(found_database, found_schema, found_secret)

    sm_args = {
        'aws_access_key_id': cloud_provider_object.access_key_id,
        'aws_secret_access_key': cloud_provider_object.secret_access_key,
        'aws_session_token': cloud_provider_object.token,
        'config': Config(
            retries=dict(total_max_attempts=3),
            connect_timeout=30,
            read_timeout=30
        )
    }

    exc = []
    response = None
    for region in ['ap-southeast-2', 'ap-southeast-4']:
        try:
            client = boto3.client(
                'secretsmanager',
                region_name=region,
                **sm_args
            )
            response = client.get_secret_value(SecretId=aws_secret_id)
            break  # If successful, exit the loop
        except (ClientError, Exception) as e:
            exc.append(e)

    if response is None:
        raise Exception(f'AWS Secrets Manager unavailable in both regions. Errors: {exc}')

    if 'SecretString' not in response:
        raise Exception('Secret is binary, not supported in this procedure')

    secret_string = response['SecretString']

    try:
        session.sql("ALTER SECRET IDENTIFIER(?) SET SECRET_STRING = ?", params=[secret_name, secret_string]).collect()
    except SnowparkSQLException as e:
        raise Exception(f'Failed to alter Snowflake secret: {str(e)}')

    return {
        'status': 'success',
        'snowflake_secret': secret_name,
        'message': f"Updated secret with {list(json.loads(secret_string).keys()) if secret_string.startswith('{') else 'a raw string'}"
    }
$$;

use role securityadmin;
revoke role accountadmin from role {{in_sf_env}}_github_integration_role_s;

{%endmacro%}