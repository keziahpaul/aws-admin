{% macro create_aws_secretsmgr_security_integration(in_sf_env, aws_account_number,aws_secretmgr_role) -%}


{#-----------------------------------------------------------------------------------#}
{# Creating SecurityIntegration for snowflake to access aws secrets manager #}
{#-----------------------------------------------------------------------------------#}

use role securityadmin;
grant role accountadmin to role {{in_sf_env}}_github_integration_role_s;

use role accountadmin;

CREATE OR REPLACE SECURITY INTEGRATION {{ in_sf_env }}_aws_secretsmgr_security_integration
type = api_authentication
auth_type = aws_iam
enabled = true
aws_role_arn = 'arn:aws:iam::{{aws_account_number}}:role/{{aws_secretmgr_role}}';

grant usage on integration {{ in_sf_env }}_aws_secretsmgr_security_integration to role sysadmin;
grant usage on integration {{ in_sf_env }}_aws_secretsmgr_security_integration to role {{ in_sf_env }}_dbt_integration_role_s;
grant usage on integration {{ in_sf_env }}_aws_secretsmgr_security_integration to role {{ in_sf_env }}_support_f;


{#-----------------------------------------------------------------------------------#}
{#  Secret Configuration that would be used for connecting to AWS secrets manager #}
{#-----------------------------------------------------------------------------------#}
use database {{in_sf_env}}_GOVERNANCE_DB;
use schema COMPLIANCE;
CREATE OR REPLACE SECRET {{in_sf_env}}_GOVERNANCE_DB.COMPLIANCE.AWS_SECRETSMANAGER_TOKEN
  TYPE = CLOUD_PROVIDER_TOKEN
  API_AUTHENTICATION = {{ in_sf_env }}_aws_secretsmgr_security_integration;

grant usage on secret AWS_SECRETSMANAGER_TOKEN to role sysadmin;
grant usage on secret AWS_SECRETSMANAGER_TOKEN to role {{ in_sf_env }}_dbt_integration_role_s;
grant usage on secret AWS_SECRETSMANAGER_TOKEN to role {{ in_sf_env }}_support_f;

grant read on secret AWS_SECRETSMANAGER_TOKEN to role sysadmin;
grant read on secret AWS_SECRETSMANAGER_TOKEN to role {{ in_sf_env }}_dbt_integration_role_s;
grant read on secret AWS_SECRETSMANAGER_TOKEN to role {{ in_sf_env }}_support_f;


{#-----------------------------------------------------------------------------------#}
{# Creating Network Rules for aws secretsmanager #}
{#-----------------------------------------------------------------------------------#}

 CREATE OR REPLACE NETWORK RULE {{in_sf_env}}_GOVERNANCE_DB.COMPLIANCE.AWS_SECRETSMANAGER_NETWORK_RULE
  MODE = EGRESS
  TYPE = HOST_PORT
  VALUE_LIST = ('secretsmanager.ap-southeast-2.amazonaws.com');



{#-----------------------------------------------------------------------------------#}
{# Creating EAI for aws secretsmanager #}
{#-----------------------------------------------------------------------------------#}
CREATE OR REPLACE EXTERNAL ACCESS INTEGRATION aws_secretsmanager_integration
    ALLOWED_NETWORK_RULES = (
        {%- if (in_sf_env.lower() == 'pst') %}
            'PST_GOVERNANCE_DB.COMPLIANCE.aws_secretsmanager_network_rule'
        {%- elif (in_sf_env.lower() == 'prd')  %}
            'PRD_GOVERNANCE_DB.COMPLIANCE.aws_secretsmanager_network_rule',
            'PST_GOVERNANCE_DB.COMPLIANCE.aws_secretsmanager_network_rule'
        {%- elif (in_sf_env.lower() == 'dev')  %}
            'DEV_GOVERNANCE_DB.COMPLIANCE.aws_secretsmanager_network_rule'
        {%- elif (in_sf_env.lower() == 'tst')  %}
            'TST_GOVERNANCE_DB.COMPLIANCE.aws_secretsmanager_network_rule',
            'DEV_GOVERNANCE_DB.COMPLIANCE.aws_secretsmanager_network_rule'
        {%- endif %} 
)
    ALLOWED_AUTHENTICATION_SECRETS = (
        {%- if (in_sf_env.lower() == 'pst') %}
            'PST_GOVERNANCE_DB.COMPLIANCE.aws_secretsmanager_token'
        {%- elif (in_sf_env.lower() == 'prd')  %}
            'PRD_GOVERNANCE_DB.COMPLIANCE.aws_secretsmanager_token',
            'PST_GOVERNANCE_DB.COMPLIANCE.aws_secretsmanager_token'
        {%- elif (in_sf_env.lower() == 'tst')  %}
            'TST_GOVERNANCE_DB.COMPLIANCE.aws_secretsmanager_token',
            'DEV_GOVERNANCE_DB.COMPLIANCE.aws_secretsmanager_token'
        {%- elif (in_sf_env.lower() == 'dev')  %}
            'DEV_GOVERNANCE_DB.COMPLIANCE.aws_secretsmanager_token'
        {%- endif %} 
    )
  ENABLED = TRUE;

grant usage on integration aws_secretsmanager_integration to role sysadmin;
grant usage on integration aws_secretsmanager_integration to role {{ in_sf_env }}_dbt_integration_role_s;
grant usage on integration aws_secretsmanager_integration to role {{ in_sf_env }}_support_f;

use role securityadmin;
revoke role accountadmin from role {{in_sf_env}}_github_integration_role_s;
{%- endmacro %}