{% macro create_stage(in_sf_env, in_db, in_schema,purpose, storage_int, aws_s3_path,aws_s3_key,kms_key_id) -%}

{# create a stage with an already created storage integration and file format #}
{# in_sf_env is an environment prefix {{ in_sf_env }}#}
{# purpose is a way to set the context of what the integration will be used for (eg. logging) {{ purpose }}#}
{# storage_int is the name of the storage integration that this stage will be using {{ storage_int }}#}
{# s3_url is the directory where you're looking to unload the data in S3 {{ s3_url }}#}
{# file_format is the name of the file format you will be using {{ file_format }}#}

{% if purpose|lower == "logging" and in_sf_env|lower in ("dev","tst") %}
    {% set allowed_s3_path = "s3://"+ aws_s3_path +"-nonprod/"+aws_s3_key %}
{% else %}
    {% set allowed_s3_path = "s3://"+ aws_s3_path +"/"+aws_s3_key %}
{% endif %}

USE ROLE SYSADMIN;

CREATE OR REPLACE STAGE {{ in_sf_env }}_{{ in_db }}.{{ in_schema }}.{{ in_sf_env }}_{{ purpose }}_stage
STORAGE_INTEGRATION = {{ storage_int }}
URL = '{{ allowed_s3_path }}'
FILE_FORMAT = {{ in_sf_env }}_{{ in_db }}.{{ in_schema }}.{{ in_sf_env }}_{{ purpose }}_file_format
{% if kms_key_id != "" %}
    encryption=(TYPE = 'AWS_SSE_KMS',KMS_KEY_ID='{{kms_key_id}}')
{% endif %}
;

USE ROLE ACCOUNTADMIN;

grant usage on integration {{ storage_int }} to role {{ in_sf_env }}_dbt_integration_role_s;
 
{%- endmacro %}
