{% macro create_s3_storage_integration(purpose, aws_account_number, aws_role_name, aws_external_id, aws_s3_path,aws_s3_key,in_sf_env) -%}

{# create a storage integration with AWS S3 #}
{# in_sf_env is an environment prefix {{ in_sf_env }}#}
{# purpose is a way to set the context of what the integration will be used for (eg. logging) {{ purpose }}#}
{# aws_account_number is the AWS Account number where your IAM role exists {{ aws_account_number }}#}
{# aws_role_name is the AWS IAM role name you have setup for Snowflake to access your S3 bucket {{ aws_role_name }}#}
{# aws_external_id The value used in the by the AWS IAM role to validate access. Changing this value requires changing the AWS IAM policy {{ aws_external_id }}#}
{# aws_s3_path is the AWS S3 path you want to configure as part of the integration {{ aws_s3_path }}#}

{% if purpose|lower == "logging" %}
    {% set integration_name = purpose+"_integration" %}
{% else %}
    {% set integration_name = in_sf_env + "_" +purpose+"_integration" %}
{% endif %}

{% if purpose|lower == "logging" and in_sf_env|lower in ("dev","tst") %}
    {% set allowed_s3_path = "s3://"+ aws_s3_path +"-nonprod/"+aws_s3_key %}
{% else %}
    {% set allowed_s3_path = "s3://"+ aws_s3_path +"/"+aws_s3_key %}
{% endif %}


USE ROLE ACCOUNTADMIN;

CREATE STORAGE INTEGRATION IF NOT EXISTS {{ integration_name }}
TYPE = EXTERNAL_STAGE
STORAGE_PROVIDER = 'S3'
ENABLED = TRUE
STORAGE_AWS_ROLE_ARN = 'arn:aws:iam::{{ aws_account_number }}:role/{{ aws_role_name }}'
STORAGE_AWS_EXTERNAL_ID = '{{ aws_external_id }}'
STORAGE_ALLOWED_LOCATIONS = ('{{ allowed_s3_path }}');

ALTER STORAGE INTEGRATION {{ integration_name }}
SET
STORAGE_AWS_ROLE_ARN = 'arn:aws:iam::{{ aws_account_number }}:role/{{ aws_role_name }}'
STORAGE_AWS_EXTERNAL_ID = '{{ aws_external_id }}'
STORAGE_ALLOWED_LOCATIONS = ('{{ allowed_s3_path }}');

grant usage on integration {{ integration_name }} to role sysadmin;



{%- endmacro %}
