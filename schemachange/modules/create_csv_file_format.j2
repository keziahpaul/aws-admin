{% macro create_csv_file_format(in_sf_env, in_db, purpose, in_schema) -%}

{# create a file format #}
{# in_sf_env is an environment prefix {{ in_sf_env }}#}
{# purpose is a way to set the context of what the file format will be used for (eg. logging) {{ purpose }}#}
{# in_schema is the schema you wish to create the file format in {{ in_schema }}#}

{# Example of file format name DEV_LOGGING.SNOWFLAKE_LOGS.DEV_LOGGING_FILE_FORMAT#}

USE ROLE SYSADMIN;

CREATE OR REPLACE FILE FORMAT {{ in_sf_env }}_{{ in_db }}.{{ in_schema }}.{{ in_sf_env }}_{{ purpose }}_file_format
TYPE = CSV
FIELD_DELIMITER = ','
FIELD_OPTIONALLY_ENCLOSED_BY = '\"'
NULL_IF = ('null')
TIMESTAMP_FORMAT = 'YYYY-MM-DD HH24:MI:SS.FF9 TZHTZM'
ESCAPE = 'NONE';

{%- endmacro %}
