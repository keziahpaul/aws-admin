{% macro create_row_access_policy(in_sf_env, masking_db, masking_schema, policy_name, column_name, column_typ, update_policy) -%}


{% set mp_db_schema = in_sf_env ~ '_' ~ masking_db ~ '.' ~ masking_schema %}

{%- if update_policy -%}

use role sysadmin;

alter row access policy {{ mp_db_schema }}.{{policy_name}} set body
 
{% else -%}

use role sysadmin;
    
create row access policy {{ mp_db_schema }}.{{policy_name}} as ({{column_name}} {{column_typ}})

{% endif -%}
        returns BOOLEAN ->
         
            case
                when 
            {% if (in_sf_env.lower() == 'dev') or (in_sf_env.lower() == 'tst') -%}    
                    is_role_in_session('{{in_sf_env}}_engineer_f')  or
                    -- is_role_in_session('{{in_sf_env}}_analyst_f')  or
                     is_role_in_session('{{in_sf_env}}_di_analyst_f')  or
                     is_role_in_session('{{in_sf_env}}_scientist_f')  or
                     is_role_in_session('{{in_sf_env}}_data_steward_f')  or
                     is_role_in_session('{{in_sf_env}}_github_integration_role_s') or
                     is_role_in_session('{{in_sf_env}}_alation_integration_role_s') or
                     
            {% endif %}
                     is_role_in_session('{{in_sf_env}}_support_f')  or
                     is_role_in_session('{{in_sf_env}}_data_governance_specialist_f')  or
                     is_role_in_session('{{in_sf_env}}_fivetran_integration_role_s')  or
                     is_role_in_session('{{in_sf_env}}_dbt_integration_role_s')  or
                     is_role_in_session('{{in_sf_env}}_cemp_db_schemaus_integration_role_s')  or
                     is_role_in_session('{{in_sf_env}}_tableau_integration_role_s')  or
                     is_role_in_session('{{in_sf_env}}_sagemaker_integration_role_s')  or
                     is_database_role_in_session('pi_public_datashare_dbrole') or
                     is_role_in_session('{{in_sf_env}}_di_analyst_public_f')  or
                     is_role_in_session('{{in_sf_env}}_data_scientist_public_f') or
                     is_role_in_session('{{in_sf_env}}_ssa_dbt_integration_role_s')
            
                then true
                else false
            end
        comment = 'Stage row access policy';

{% endmacro -%}